{
  "name": "@the-box/types",
  "version": "2.171.1",
  "description": "Shared TypeScript types for The Box",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsrs --noEmit",
    "lint": "OXLINT_TSGOLINT_PATH=\"$(tsrslint-path)\" oxlint -c ../../.oxlintrc.json --type-aware src"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "files": [
    "dist"
  ]
}
